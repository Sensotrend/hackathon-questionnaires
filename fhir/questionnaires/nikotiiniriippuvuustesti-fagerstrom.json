      "item": [
        {
          "linkId": "518c3e67-7bb2-4f1e-997c-09e72d11096c",
          "text": "Kuinka pian (minuuteissa) herättyäsi poltat ensimmäisen savukkeen?",
          "_text": {
            "extension": [
              {
                "url": "http://hl7.org/fhir/StructureDefinition/translation",
                "extension": [
                  {
                    "url": "lang",
                    "valueCode": "sv"
                  },
                  {
                    "url": "content",
                    "valueString": "Hur många minuter efter att du vaknat röker du din första cigarrett?"
                  }
                ]
              },
              {
                "url": "http://hl7.org/fhir/StructureDefinition/translation",
                "extension": [
                  {
                    "url": "lang",
                    "valueCode": "en"
                  },
                  {
                    "url": "content",
                    "valueString": "How soon after waking up do you smoke your first cigarette?"
                  }
                ]
              }
            ]
