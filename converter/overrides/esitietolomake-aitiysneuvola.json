    "886e1458-5df1-41e5-b928-ac4fce486ea9": {
      "$comment": "Previously pregnant: yes when a recorded parity is above zero (gravidity is not used: it may include the current pregnancy)",
      "populate": {
        "answer": "Kyllä",
        "when": {
          "in": "observations",
          "codes": {
            "http://loinc.org": [
              "11977-6"
            ]
          },
          "where": "(value.ofType(integer) | value.ofType(Quantity).value).first() > 0"
        }
      }
    },
